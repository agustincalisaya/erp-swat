// ============================================================================
// SWAT INDUMENTARIAS ERP — SPRINT 1
// Módulo D: Seguridad, RBAC y Auditoría Forense
// Módulo A: Inventario, SKUs, Depósitos y Movimientos
// ============================================================================
// Reglas transversales aplicadas:
//  - Soft Delete estricto (is_active, deleted_at, deleted_by, deletion_reason)
//    en TODA tabla transaccional o de catálogo.
//  - Integridad referencial: onDelete: Restrict en TODAS las relaciones.
//    Prohibido el borrado en cascada.
//  - Nomenclatura: modelos PascalCase, campos snake_case, tablas @@map
//    en minúsculas y plural.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// --- MÓDULO D: GESTIÓN DE USUARIOS, RBAC Y AUDITORÍA ---
// ============================================================================

/// Usuario del sistema. Almacena credenciales con hash+sal, nunca la
/// contraseña en texto plano. Controla intentos fallidos para políticas
/// de bloqueo por fuerza bruta.
model Usuario {
  id                String        @id @default(uuid())
  nombre_usuario    String        @unique
  email             String        @unique
  password_hash     String
  password_salt     String
  nombre_completo   String
  estado            EstadoUsuario @default(ACTIVO)
  intentos_fallidos Int           @default(0)
  bloqueado_hasta   DateTime?
  ultimo_login      DateTime?

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  roles                   UsuarioRol[]
  audit_logs              AuditLog[]
  movimientos_registrados MovimientoStock[] @relation("MovimientoRegistradoPor")
  reservas_registradas    Reserva[]         @relation("ReservaRegistradaPor")
  sesiones                Sesion[]

  @@map("usuarios")
}

enum EstadoUsuario {
  ACTIVO
  SUSPENDIDO
  BLOQUEADO
  INACTIVO
}

/// Rol funcional dentro del sistema RBAC (ej: ADMIN, DEPOSITO, AUDITOR).
/// Se vincula a Permiso mediante tabla pivote N:M (RolPermiso).
model Rol {
  id          String  @id @default(uuid())
  nombre      String  @unique
  descripcion String?

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("roles")
}

/// Permiso granular atómico (ej: "inventario:crear", "auditoria:leer").
/// Principio de menor privilegio: cada permiso debe representar la unidad
/// mínima de acción posible.
model Permiso {
  id          String  @id @default(uuid())
  codigo      String  @unique
  descripcion String?
  modulo      String // Ej: "MODULO_A", "MODULO_D"

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  roles RolPermiso[]

  @@map("permisos")
}

/// Tabla pivote N:M entre Usuario y Rol.
/// Un usuario puede tener múltiples roles asignados simultáneamente.
model UsuarioRol {
  id         String @id @default(uuid())
  usuario_id String
  rol_id     String

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Restrict)
  rol     Rol     @relation(fields: [rol_id], references: [id], onDelete: Restrict)

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([usuario_id, rol_id])
  @@map("usuario_roles")
}

/// Tabla pivote N:M entre Rol y Permiso. Define el control RBAC granular.
model RolPermiso {
  id         String @id @default(uuid())
  rol_id     String
  permiso_id String

  rol     Rol     @relation(fields: [rol_id], references: [id], onDelete: Restrict)
  permiso Permiso @relation(fields: [permiso_id], references: [id], onDelete: Restrict)

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([rol_id, permiso_id])
  @@map("rol_permisos")
}

/// Ledger inmutable (append-only) para trazabilidad forense.
/// NUNCA debe actualizarse ni borrarse un registro existente: solo INSERT.
/// Implementa cadena de hashes SHA-256 (hash_actual encadenado con
/// hash_anterior) para garantizar integridad e inmutabilidad verificable.
/// Nota: por tratarse de un ledger append-only, NO lleva soft delete
/// (is_active/deleted_at) ya que un log de auditoría jamás se "elimina".
model AuditLog {
  id             String  @id @default(uuid())
  usuario_id     String?
  accion         String // Ej: "CREATE", "UPDATE", "DELETE", "LOGIN_FAILED"
  tabla_afectada String
  registro_id    String?
  ip             String
  valor_anterior Json?
  valor_nuevo    Json?

  /// Hash SHA-256 del registro anterior en la cadena (integridad forense)
  hash_anterior String
  /// Hash SHA-256 calculado sobre este registro + hash_anterior
  hash_actual   String @unique

  created_at DateTime @default(now())

  // --- Relación ---
  usuario Usuario? @relation(fields: [usuario_id], references: [id], onDelete: Restrict)

  @@map("audit_logs")
}

/// Sesión activa de un Usuario autenticado (HU-3). Permite revocación
/// instantánea independiente de la expiración del JWT (spec_modulo_D.md
/// §3.3 y HU-2) — el JWT solo prueba identidad e integridad; esta tabla es
/// la fuente de verdad sobre si la sesión sigue siendo válida.
/// Nota: no usa el soft delete estándar de RULES.md §1 (`is_active`/
/// `deleted_at`) porque no es una entidad de catálogo/transaccional de
/// negocio — revocada/expirada/activa son tres estados propios de un
/// artefacto técnico de autenticación, no un simple activo/inactivo.
model Sesion {
  id              String    @id @default(uuid())
  usuario_id      String
  jwt_id          String    @unique // claim "jti" del JWT — vincula el token emitido con esta fila
  ip_origen       String
  user_agent      String?
  emitida_en      DateTime  @default(now())
  expira_en       DateTime
  revocada        Boolean   @default(false)
  revocada_en     DateTime?
  revocada_motivo String? // ej. "logout", "baja_logica_usuario", "cambio_password"

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Restrict)

  @@index([usuario_id])
  @@map("sesiones")
}

// ============================================================================
// --- MÓDULO A: INVENTARIO Y DEPÓSITO ---
// ============================================================================

/// Producto base/genérico del catálogo (ej: "Camisa Táctica", "Borcegos").
/// No representa una unidad vendible; las variantes concretas están en
/// VarianteSKU.
model ProductoMaestro {
  id                        String  @id @default(uuid())
  /// Código corto usado como segmento [PRODUCTO] del SKU determinístico
  /// generado por `generarSku()` (ej. "CAMP" para "Campera Softshell Nivel III").
  /// Definido explícitamente al crear el producto — no se deriva del nombre.
  /// Deliberadamente NO único: dos ProductoMaestro de la misma familia (ej.
  /// dos modelos de campera) pueden compartir el mismo código de categoría —
  /// la unicidad real del SKU la garantiza VarianteSKU.sku @unique.
  codigo_producto           String
  nombre                    String
  rubro                     String
  categoria                 String
  unidad_medida             String // Ej: "UNIDAD", "PAR", "KG"
  descripcion               String?
  proveedor_preferente      String?
  costo_estandar_referencia Decimal @db.Decimal(10, 2) // Mejor que Float para finanzas

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  variantes VarianteSKU[]

  @@map("productos_maestros")
}

/// Variante concreta y vendible de un ProductoMaestro, definida por las
/// 4 dimensiones tácticas: talle, color, genero y modelo.
/// El campo `sku` es único y determinístico (generado a partir de las
/// dimensiones); `ean_qr` es el código de trazabilidad unitaria
/// (EAN-13/QR) usado en el escaneo físico de depósito. Es opcional: queda
/// NULL hasta que se conoce el EAN-13 real de la unidad física (por
/// escaneo en el preview de la Matriz de Variantes o al primer ingreso a
/// depósito) — no se rellena con ningún valor sintético mientras tanto.
model VarianteSKU {
  id                  String  @id @default(uuid())
  producto_maestro_id String
  sku                 String  @unique
  ean_qr              String? @unique
  talle               String
  color               String
  genero              String
  modelo              String

  /// STUB Sprint futuro — Módulo H (Compras): se vinculará cada variante
  /// a su proveedor habitual. Se deja opcional para no requerir migración
  /// destructiva cuando se implemente el Módulo H.
  proveedor_id String?

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  producto_maestro ProductoMaestro   @relation(fields: [producto_maestro_id], references: [id], onDelete: Restrict)
  stock_depositos  StockDeposito[]
  movimientos      MovimientoStock[]
  reservas         Reserva[]

  @@map("variantes_sku")
}

/// Ubicación física de almacenamiento (Central, Showroom, Móvil, etc.).
model Deposito {
  id        String  @id @default(uuid())
  nombre    String  @unique
  tipo      String // Ej: "CENTRAL", "SHOWROOM", "MOVIL"
  direccion String?

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  stock_items         StockDeposito[]
  movimientos_origen  MovimientoStock[] @relation("MovimientoOrigen")
  movimientos_destino MovimientoStock[] @relation("MovimientoDestino")
  reservas            Reserva[]

  @@map("depositos")
}

/// Tabla pivote que indica la cantidad disponible de un VarianteSKU en un
/// Deposito específico. Define umbrales de reposición (`punto_pedido`) y
/// stock mínimo de seguridad (`stock_seguridad`).
model StockDeposito {
  id              String @id @default(uuid())
  variante_sku_id String
  deposito_id     String
  cantidad        Int    @default(0)
  punto_pedido    Int    @default(0)
  stock_seguridad Int    @default(0)

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  variante_sku VarianteSKU @relation(fields: [variante_sku_id], references: [id], onDelete: Restrict)
  deposito     Deposito    @relation(fields: [deposito_id], references: [id], onDelete: Restrict)

  @@unique([variante_sku_id, deposito_id])
  @@map("stock_depositos")
}

/// Registro inmutable y transaccional de todo movimiento de stock
/// (ingreso, egreso, transferencia, ajuste). Una vez creado, no debe
/// actualizarse: cualquier corrección se modela como un nuevo movimiento
/// compensatorio (principio de inmutabilidad contable).
model MovimientoStock {
  id                     String         @id @default(uuid())
  variante_sku_id        String
  deposito_origen_id     String?
  deposito_destino_id    String?
  tipo_movimiento        TipoMovimiento
  estado_origen          String?
  estado_destino         String?
  cantidad               Int
  comprobante_referencia String?
  registrado_por_id      String

  /// STUB Sprint futuro — Módulo B (POS): vinculará el movimiento de
  /// egreso con la venta que lo originó. Opcional para no romper el
  /// modelo actual cuando se integre el módulo de ventas.
  venta_id String?

  // --- Soft delete estricto ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  variante_sku     VarianteSKU @relation(fields: [variante_sku_id], references: [id], onDelete: Restrict)
  deposito_origen  Deposito?   @relation("MovimientoOrigen", fields: [deposito_origen_id], references: [id], onDelete: Restrict)
  deposito_destino Deposito?   @relation("MovimientoDestino", fields: [deposito_destino_id], references: [id], onDelete: Restrict)
  registrado_por   Usuario     @relation("MovimientoRegistradoPor", fields: [registrado_por_id], references: [id], onDelete: Restrict)

  @@map("movimientos_stock")
}

enum TipoMovimiento {
  INGRESO
  EGRESO
  TRANSFERENCIA
  AJUSTE
}

/// Reserva temporal de una unidad de stock originada por una seña o
/// licitación (Criterio 5 — Máquina de Estados). El TTL por defecto es
/// de 72 horas: si `fecha_fin_reserva` sigue siendo NULL transcurrido ese
/// tiempo, la API Cron `/api/cron/check-pruebas-vencidas` devuelve el stock
/// atómicamente al estado DISPONIBLE.
///
/// Relación con el stock:
///  - Al crear la Reserva → `StockDeposito.cantidad` se decrementa (DISPONIBLE → RESERVADO).
///  - Al liberar por TTL → `StockDeposito.cantidad` se incrementa (RESERVADO → DISPONIBLE)
///    + se registra un MovimientoStock INGRESO compensatorio.
///  - Al confirmar la venta → `fecha_fin_reserva` se setea (RESERVADO → VENDIDO).
model Reserva {
  id              String @id @default(uuid())
  variante_sku_id String
  deposito_id     String
  cantidad        Int

  /// Momento en que se inicia la reserva (inicio del TTL de 72 horas).
  fecha_inicio_reserva DateTime  @default(now())
  /// NULL = reserva activa. Se setea al confirmar venta o al liberar por TTL.
  fecha_fin_reserva    DateTime?

  /// Motivo legible de la reserva (ej: "Seña N.° 1234", "Licitación GCBA-2026-001").
  /// Opcional pero recomendado para trazabilidad.
  motivo String?

  /// ID del vendedor o usuario que creó la reserva.
  registrado_por_id String

  // --- Soft delete estricto (RULES.md §1) ---
  is_active       Boolean   @default(true)
  deleted_at      DateTime?
  deleted_by      String?
  deletion_reason String?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // --- Relaciones ---
  variante_sku   VarianteSKU @relation(fields: [variante_sku_id], references: [id], onDelete: Restrict)
  deposito       Deposito    @relation(fields: [deposito_id], references: [id], onDelete: Restrict)
  registrado_por Usuario     @relation("ReservaRegistradaPor", fields: [registrado_por_id], references: [id], onDelete: Restrict)

  /// Índice compuesto para la query del cron: busca reservas activas sin cierre
  /// dentro de una ventana temporal (fecha_inicio_reserva < umbral).
  @@index([is_active, fecha_fin_reserva, fecha_inicio_reserva])
  @@map("reservas")
}
