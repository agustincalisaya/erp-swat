# ========================
# NO BORRAR - DUPLICAR
# ========================

# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# The following `prisma+postgres` URL is similar to the URL produced by running a local Prisma Postgres 
# server with the `prisma dev` CLI command, when not choosing any non-default ports or settings. The API key, unlike the 
# one found in a remote Prisma Postgres URL, does not contain any sensitive information.

DATABASE_URL=""

# =============================================================================
# JWT DE SESIÓN — HU-3 (Login, Logout, Middleware)
# Requerido por: lib/auth/jwt.ts — firma/verificación del JWT en cookie httpOnly
# Formato:  64 caracteres hexadecimales = 32 bytes
# Generar:  openssl rand -hex 32
# =============================================================================

JWT_SECRET=""

# JWT de sesión de CLIENTE WEB — HU-E8 (mínimo provisional de HU-E1)
# Requerido por: lib/auth/sesion-cliente-web.ts. 64 hex (openssl rand -hex 32).
# DEBE ser distinto de JWT_SECRET: la sesión de la tienda está aislada del RBAC.
JWT_SECRET_CLIENTE_WEB=""

# Firma HMAC de la cookie del carrito de visitante — HU-E1 (spec E §2.1).
# Requerido por: lib/services/ecommerce/carrito-token.ts. 64 hex (openssl rand -hex 32).
CARRITO_COOKIE_SECRET=""

# =============================================================================
# CRON — Liberación automática de Reservas vencidas por TTL (HU-A10)
# Requerido por: src/app/api/cron/check-pruebas-vencidas/route.ts
# El orquestador de cron (Vercel Cron, GitHub Actions, cron-job.org…) debe
# enviar `Authorization: Bearer <CRON_SECRET>` en el POST.
# En desarrollo, si se omite, el endpoint queda accesible sin auth.
# Generar:  openssl rand -hex 32
# =============================================================================

CRON_SECRET=""

# =============================================================================
# AES-256-GCM — Cifrado en reposo de datos bancarios del legajo de Proveedor
# (HU-H1, spec_modulo_H.md §3.3 · RULES.md Regla N.° 2 · Ley N.° 25.326)
# Requerido por: lib/crypto/aes.ts — encrypt()/decrypt() de datos bancarios
# Formato:  64 caracteres hexadecimales = 32 bytes (exactamente 64 hex)
# Generar:  openssl rand -hex 32
# OJO:  nunca commitear el valor real. Esta variable va SOLO en el .env local.
# =============================================================================

ENCRYPTION_KEY_PROVEEDORES=""


# =============================================================================
# MERCADO PAGO — HU-E2 (pago online) / HU-F1 (Conector, owner: Rama)
# Credenciales de PRUEBA de tu cuenta de Mercado Pago (Tus integraciones →
# Credenciales de prueba; Webhooks → clave secreta). El SEED las cifra con
# ENCRYPTION_KEY_PROVEEDORES y las guarda en ConectorPago (SANDBOX); la app las
# lee SIEMPRE del Conector, nunca de acá. Sin las tres, el Conector queda con
# credenciales ficticias (usar MP_MODO=simulado). Después de cargarlas:
# `npx prisma db seed`. NUNCA commitear valores reales.
# =============================================================================

MP_SANDBOX_ACCESS_TOKEN=""
MP_SANDBOX_PUBLIC_KEY=""
MP_SANDBOX_WEBHOOK_SECRET=""

# URL pública de la app: base de notification_url (/api/webhooks/mercadopago) y
# de las back_urls de Checkout Pro. En desarrollo, la URL HTTPS del túnel
# (ej. https://xxxx.ngrok-free.app). Sin barra final.
APP_PUBLIC_URL=""

# Solo desarrollo: "simulado" = Mercado Pago falso (sin red). consultarPago()
# lee los pagos de .mp-simulador/pagos.json (los carga `npm run mp:firmar`).
# Prohibido en producción. Vacío = Mercado Pago real (sandbox).
MP_MODO=""
